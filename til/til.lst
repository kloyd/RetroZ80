0415   033A             ;----------------------------------------
0416   033A             ; CP/M Machine Specific routines
0417   033A             ;
0418   033A             ; *   Internal Routines interfacing with Operating System.
0419   033A             ; * _ECHO - Echo a character to terminal
0420   033A             ; * _KEY - Read a key from terminal
0421   033A             ; * _CRLF - Output CR/LF to terminal
0422   033A             ;----------------------------------------
0423   033A             ;; Handy Constants
0424   033A             CR	EQU     0DH
0425   033A             LF	EQU     0AH
0426   033A             DOLLAR  EQU     24H
0427   033A             ESC     EQU     1BH
0428   033A             CTRLC   EQU     03H
0429   033A             
0430   033A             ; Screen print calls
0431   033A             CHAR_IN EQU     03H
0432   033A             C_STAT  EQU     0BH
0433   033A             C_RAWIO EQU     06H
0434   033A             
0435   033A             ; til has own write str using _ECHO
