0113   019A             
0114   019A             
0115   019A             ; SEARCH Primitive
0116   019A 06 53 45 41         DB      6,'SEA'
0117   019E DA 01               DW      AT - 6     ; Point to the Entry proper.
0118   01A0 A2 01       SEARCH  DW      $ + 2
0119   01A2 D9                  EXX     ; save registers
0120   01A3 E1                  POP     HL      ; start of header
0121   01A4 E5          TESTIT  PUSH    HL      ; save start of header
0122   01A5 ED 5B 8B 04         LD      DE,(DP)         ;dictionary pointer.
0123   01A9 0E 00               LD      C, 0    ; used with B as false flag
0124   01AB 1A                  LD      A,(DE)  ;get dictionary token length
0125   01AC BE                  CP      (HL)    ; same as keyword length?
0126   01AD C2 C7 01            JP      NZ, NXTHDR      ; go to next entry in linked list.
0127   01B0 FE 04               CP      4       ; Is length over 3?
0128   01B2 38 02               JR      C, BEL04        ; skip set 3
0129   01B4 3E 03               LD      A, 3    ; length = 3
0130   01B6 47          BEL04   LD      B, A
0131   01B7 23          NEXTCH  INC     HL      ; Bump header
0132   01B8 13                  INC     DE      ; bump dictionary pointer.
0133   01B9 1A                  LD      A, (DE) ; next character
0134   01BA BE                  CP      (HL)
0135   01BB 20 0A               JR      NZ, NXTHDR      ; Go to next header entry.
0136   01BD 10 F8               DJNZ    NEXTCH          ; next character
0137   01BF E1                  POP     HL      ; start of found header
0138   01C0 11 06 00            LD      DE,6    ; start plus 6
0139   01C3 19                  ADD     HL,DE   ; == Word Address
0140   01C4 E5                  PUSH    HL      ; push WA; BC = 0 for Flag.
0141   01C5 18 0F               JR      FLAG
0142   01C7 E1          NXTHDR  POP     HL      ; start of current header
0143   01C8 11 04 00            LD      DE,4    ; plus 4 == Link Address (pointer to next entry)
0144   01CB 19                  ADD     HL, DE  ; To Next keyword
0145   01CC 5E                  LD      E, (HL) ; get link address
0146   01CD 23                  INC     HL
0147   01CE 56                  LD      D, (HL)
0148   01CF EB                  EX      DE, HL
0149   01D0 7C                  LD      A, H
0150   01D1 B5                  OR      L
0151   01D2 20 D0               JR      NZ, TESTIT ; not 0, test next header.
0152   01D4 0E 01               LD      C, 1    ; false
0153   01D6 C5          FLAG    PUSH    BC      ; push flag
0154   01D7 D9                  EXX             ;Restore registers
0155   01D8 FD E9               JP      (IY)    ; back to NEXT
0156   01DA             
0157   01DA             ; @ - AT (Assembler won't allow @ for a label.)
0158   01DA 01 40 00 00         DB      1,'@',0,0   ; Search will find length of 1 and only look at first char. others are spaces to fill 3 bytes.
0159   01DE E9 01               DW      CONTEXT - 6
0160   01E0 E2 01       AT      DW      $ + 2
