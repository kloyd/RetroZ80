                        ; *****  TIL
                        ; Outer Interpreter
                        ; Author Kelly Loyd
                        ; Target System
                        ;   Z80 CP/M 64K RAM
                        ; ***

                        ; Non Standard Z80 MC
      = 0001            std_cpm = 1
                        ; Use CPM BDOS?
      = 0001            CPM = 1

                        ;---------- Put in CP/M Transient Memory space.
                         IF CPM = 1
0100                    	ORG	100H
                         ELSE
                         ENDIF
0100  C3 0301           	JP	START

                        ;---------- START/RESTART
0103  11 8D04           START	LD	DE,RSTMSG
0106  3A E003           	LD	A,(BASE)
0109  A7                	AND	A
010A  20 08             	JR	NZ, ABORT
010C  3E 0A             	LD	A,10
010E  32 E003           	LD	(BASE),A
0111  11 9A04           	LD	DE,SRTMSG
0114  31 0080           ABORT	LD	SP,STACK
0117  D5                	PUSH	DE
0118  21 0000           	LD	HL,0
011B  22 8804           	LD	(MODEPTR),HL
011E  FD21 5A01         	LD	IY,NEXT
0122  DD21 A703         	LD	IX,RETURN
0126  21 8080           	LD	HL,8080h
0129  22 8004           	LD	(LBEND),HL
012C  01 3201           	LD	BC,OUTER	; Effectively, Set OUTER as the next routine
012F  C3 5A01           	JP	NEXT		; Call NEXT in the Inner Interpreter, which will load address of OUTER and Jump to it.

                        ; Entry point of OUTER interpreter.
0132  8802              OUTER	DW	TYPE
0134  9C02              	DW	INLINE
0136  F402              	DW	ASPACE
0138  7A01              	DW	TOKEN
013A  5802              	DW 	QSEARCH	; Leaves something on the stack if found or not found?
013C  6603              	DW	AT_IF
013E  0B                	DB	0BH
013F  0103              	DW	QNUMBER
0141  7F03              	DW	AT_END
0143  F3                	DB	F3H
0144  8D03              	DW	QUESTION
0146  7B03              	DW	AT_WHILE
0148  EA                	DB	EAH
0149  FC02              	DW	QEXECUTE
014B  7B03              	DW	AT_WHILE
014D  E9                	DB	E9H
                        ; End of OUTER - Infinite loop



                        ; --------- Inner Interpreter
014E  5001              SEMI	DW	$ + 2
0150  DD4E 00           	LD	C,(IX+0)
0153  DD23              	INC	IX
0155  DD46 00           	LD	B,(IX+0)
0158  DD23              	INC	IX
015A  0A                NEXT	LD	A,(BC)	; BC = Instruction Register
015B  6F                	LD	L,A	; @I -> WA (HL = word address)
015C  03                	INC	BC
015D  0A                	LD	A,(BC)
015E  67                	LD	H,A
015F  03                	INC	BC	; I = I + 2
0160  5E                RUN	LD	E,(HL)	; @WA -> CA (Code Address)
0161  23                	INC	HL	; WA = WA + 2
0162  56                	LD	D,(HL)
0163  23                	INC	HL
0164  EB                	EX	DE,HL	; CA -> PC
0165  E9                	JP	(HL)

0166  DD2B              COLON	DEC	IX
0168  DD70 00           	LD	(IX+0),B
016B  DD2B              	DEC	IX
016D  DD71 00           	LD	(IX+0),C
0170  4B                	LD	C,E
0171  42                	LD	B,D
0172  FDE9              	JP	(IY)
                        ;----------- End of Inner -----

                        ;----------   IMPORTANT - Start of Vocabulary, Dictionary Entries
                        ;   Any code that is INTERNAL only, should come after the last Dictionary Entry.
0174                    DICT_BEG
0174  05544F4B                  DB 5,'TOK'	; TOKEN ID
0178  AB01              	DW	SEARCH - 6      ; should point to the Entry start.
017A  7C01              TOKEN	DW	$ + 2
017C  D9                	EXX 	; Save IR (EXX exchanges BC, DE, and HL with shadow registers with BC', DE', and HL'.)
017D  2A E203           	LD	HL,(LBP) ; pointer to token
0180  ED5B 8B04         	LD	DE,(DP) ; pointer to Dictionary
0184  C1                	POP 	BC	; space left by ASPACE
0185  3E 20             	LD	A,20H 	; space code
0187  B9                	CP	C 	; space?
0188  20 06             	JR 	NZ, TOK
018A  BE                IGNLB	CP	(HL)
018B  20 03             	JR	NZ,TOK
018D  2C                	INC	L
018E  18 FA             	JR 	IGNLB
0190  E5                TOK	PUSH	HL
0191  04                COUNT	INC	B
0192  2C                	INC 	L
0193  7E                	LD 	A,(HL)
0194  B9                	CP 	C
0195  28 04             	JR 	Z,ENDTOK
0197  17                	RLA
0198  30 F7             	JR 	NC,COUNT
019A  2D                	DEC	L
019B  2C                ENDTOK	INC	L
019C  22 E203           	LD 	(LBP), HL
019F  78                	LD	A,B
01A0  12                	LD	(DE), A
01A1  13                	INC	DE
01A2  E1                	POP	HL
01A3  48                	LD 	C,B
01A4  06 00             	LD 	B,0
01A6  EDB0              	LDIR  		; Move token to dictionary
01A8  D9                	EXX
01A9  FDE9              	JP 	(IY)


                        ; SEARCH Primitive
01AB  06534541                  DB      6,'SEA'
01AF  EB01                      DW      AT - 6     ; Point to the Entry proper.
01B1  B301              SEARCH  DW      $ + 2
01B3  D9                        EXX     ; save registers
01B4  E1                        POP     HL      ; start of header
01B5  E5                TESTIT  PUSH    HL      ; save start of header
01B6  ED5B 8B04                 LD      DE,(DP)         ;dictionary pointer.
01BA  0E 00                     LD      C, 0    ; used with B as false flag
01BC  1A                        LD      A,(DE)  ;get dictionary token length
01BD  BE                        CP      (HL)    ; same as keyword length?
01BE  C2 D801                   JP      NZ, NXTHDR      ; go to next entry in linked list.
01C1  FE 04                     CP      4       ; Is length over 3?
01C3  38 02                     JR      C, BEL04        ; skip set 3
01C5  3E 03                     LD      A, 3    ; length = 3
01C7  47                BEL04   LD      B, A
01C8  23                NEXTCH  INC     HL      ; Bump header
01C9  13                        INC     DE      ; bump dictionary pointer.
01CA  1A                        LD      A, (DE) ; next character
01CB  BE                        CP      (HL)
01CC  20 0A                     JR      NZ, NXTHDR      ; Go to next header entry.
01CE  10 F8                     DJNZ    NEXTCH          ; next character
01D0  E1                        POP     HL      ; start of found header
01D1  11 0600                   LD      DE,6    ; start plus 6
01D4  19                        ADD     HL,DE   ; == Word Address
01D5  E5                        PUSH    HL      ; push WA; BC = 0 for Flag.
01D6  18 0F                     JR      FLAG
01D8  E1                NXTHDR  POP     HL      ; start of current header
01D9  11 0400                   LD      DE,4    ; plus 4 == Link Address (pointer to next entry)
01DC  19                        ADD     HL, DE  ; To Next keyword
01DD  5E                        LD      E, (HL) ; get link address
01DE  23                        INC     HL
01DF  56                        LD      D, (HL)
01E0  EB                        EX      DE, HL
01E1  7C                        LD      A, H
01E2  B5                        OR      L
01E3  20 D0                     JR      NZ, TESTIT ; not 0, test next header.
01E5  0E 01                     LD      C, 1    ; false
01E7  C5                FLAG    PUSH    BC      ; push flag
01E8  D9                        EXX             ;Restore registers
01E9  FDE9                      JP      (IY)    ; back to NEXT

                        ; @ - AT (Assembler won't allow @ for a label.)
01EB  01400000                  DB      1,'@',0,0   ; Search will find length of 1 and only look at first char. others are spaces to fill 3 bytes.
01EF  FA01                      DW      CONTEXT - 6
01F1  F301              AT      DW      $ + 2
01F3  E1                        POP     HL
01F4  5E                        LD      E, (HL) ; low byte at address
01F5  23                        INC     HL
01F6  56                        LD      D, (HL) ; high byte
01F7  D5                        PUSH    DE
01F8  FDE9                      JP      (IY)

                        ; CONTEXT, pushes to the stack the address of Vocabulary
01FA  07434F4E                  DB      7,'CON'
01FE  0802                      DW	MODE - 6
0200  0202              CONTEXT DW      $ + 2
0202  11 8604           	LD	DE, CTXTPTR
0205  D5                	PUSH	DE
0206  FDE9              	JP	(IY)

                        ; MODE, pushes mode pointer to stack
0208  044D4F44          	DB	4,'MOD'
020C  1602              	DW	EXECUTE -6
020E  1002              MODE	DW	$ + 2
0210  11 8804           	LD	DE, MODEPTR
0213  D5                	PUSH	DE
0214  FDE9              	JP	(IY)

                        ; EXECUTE primitive needs a dictionary entry for defining words.
                        ; This is a model for all other Primitive words that will be added to the dictionary
                        ;
0216  07455845          	DB	7,'EXE'	; Header for dictionary search
021A  2202              	DW	C@ - 6		; Link address 0000 == End of Linked List.
021C  1E02              EXECUTE DW	$ + 2		; Address of EXECUTE.
021E  E1                	POP	HL		; primitive code.
021F  C3 6001           	JP	RUN

0222  02434020          	DB 2,'C@ '
0226  3302              	DW	DROP - 6
0228  2A02              C@	DW $ + 2
022A  E1                	POP		HL
022B  5E                	LD		E,(HL)
022C  7B                	LD		A,E
022D  17                	RLA
022E  9F                	SBC		A,A
022F  57                	LD		D,A
0230  D5                	PUSH   	DE
0231  FDE9              	JP (IY)

0233  0444524F          	DB	4,'DRO'
0237  3E02              	DW 	STATE - 6
0239  3B02              DROP	DW	$ + 2
023B  E1                	POP	HL
023C  FDE9              	JP (IY)

023E  05535441          	DB 5,'STA' ; STATE
0242  4602              	DW	CX - 6
0244                    STATE
0244  4602              	DW	$ + 2

                        	;; PUSH TO STACK ADDRESS OF SYSTEM STATE VARIABLE
                        	; TODO

0246  02432120          	DB	2,'C! '
024A  4E02              	DW	COMPILER - 6
024C  4E02              CX 	DW	$ + 2

024E  08434F4D          	DB 8, 'COM'   ; PILER --- See *SYS !!! this is an offset to compiler points to last address of compiler dictionary.
0252  0000              	DW	0000
0254                    COMPILER
0254  5602              	DW	$ + 2
0256  0000              	DW 0000

                        ;----------   End of Dictonary Entries

                        ;
                        ; ?SEARCH - Secondary to search dictionary.
0258  6601              QSEARCH DW      COLON
025A  0002                      DW      CONTEXT
025C  F101                      DW      AT
025E  F101                      DW      AT
0260  B101                      DW      SEARCH
0262  8303                      DW      DUP
0264  6603                      DW      AT_IF
0266  20                	DB	20H
0267  0E02                      DW	MODE
0269  2802              	DW	C@
026B  6603              	DW	AT_IF
026D  19                	DB	19H
026E  3902              	DW	DROP
0270  5402              	DW	COMPILER
0272  F101              	DW	AT
0274  B101              	DW	SEARCH
0276  8303              	DW	DUP
0278  6603              	DW	AT_IF
027A  06                	DB	06H
027B  0000              	DW	0
027D  7103              	DW	AT_ELSE
027F  03                	DB	03
0280  0100              	DW	1
0282  4402              	DW	STATE
0284  4C02              	DW	CX
0286  4E01              	DW	SEMI




                        ; TYPE - String with length byte (0a1234567890) printed to console.
0288  8A02              TYPE	DW	$ + 2
028A  D1                TYPEIT	POP	DE	; get address of string
028B  E5                	PUSH	HL 	; save WA
028C  C5                	PUSH	BC	; Save IR.
028D  EB                	EX	DE,HL
028E  46                	LD	B,(HL)
028F  23                	INC	HL
0290  7E                ONECHAR	LD	A,(HL)
0291  CD B303           	CALL	_ECHO
0294  23                	INC	HL
0295  10 F9             	DJNZ	ONECHAR
0297  C1                	POP	BC	; Restore IR
0298  E1                	POP	HL	; Restore WA
0299  C3 5A01           	JP	NEXT




                        ; INLINE
029C  9E02              INLINE	DW	$ + 2	;header address
029E  C5                	PUSH	BC	; Save IR
029F  CD D303           ISTART	CALL	_CRLF	; Issue CR / LF on terminal for new input
02A2  21 0004           	LD	HL, LBADD	; Buffer
02A5  22 E203           	LD	(LBP), HL
02A8  06 80             	LD	B, LENGTH
02AA  36 20             CLEAR	LD	(HL), SPACE
02AC  23                	INC	HL
02AD  10 FB             	DJNZ	CLEAR
02AF  2E 00             ZERO	LD	L,0
02B1  CD C103           INKEY	CALL	_KEY
02B4  FE 18             	CP	LINEDEL		; CTRL-X is Line Delete
02B6  20 05             	JR	NZ,TSTBS
02B8  CD B303           	CALL	_ECHO
02BB  18 E2             	JR ISTART
02BD  FE 08             TSTBS	CP	BKSP		; backspace CTRL-H
02BF  20 0B             	JR	NZ, TSTCR
02C1  2B                	DEC	HL
02C2  FA AF02           	JP	M,ZERO
02C5  36 20             	LD	(HL), SPACE
02C7  CD B303           ISSUE	CALL	_ECHO
02CA  18 E5             	JR	INKEY
02CC  FE 0D             TSTCR	CP	CR
02CE  28 1C             	JR	Z,LAST1
02D0  CB7D              	BIT	7,L
02D2  20 0E             	JR	NZ,IEND
02D4  77                SAVEIT	LD	(HL),A
02D5  FE 61             	CP	61H	; Less than LC A ?
02D7  38 06             	JR	C,NOTLC
02D9  FE 7B             	CP	7BH	; MORE THAN LC Z?
02DB  30 02             	JR	NC,NOTLC
02DD  CBAE              	RES	5,(HL)
02DF  2C                NOTLC	INC	L
02E0  18 E5             	JR	ISSUE
02E2  2D                IEND	DEC	L
02E3  4F                	LD	C,A
02E4  3E 08             	LD	A,BKSP
02E6  CD B303           	CALL	_ECHO
02E9  79                	LD	A,C
02EA  18 E8             	JR 	SAVEIT
02EC  3E 20             LAST1	LD	A, SPACE
02EE  CD B303           	CALL	_ECHO
02F1  C1                	POP	BC
02F2  FDE9              	JP	(IY)	; Return to NEXT inner interpreter.

                        ; Push 20h to stack, will pop into BC in TOKEN, and BC will be 0020h
02F4  F602              ASPACE	DW	$ + 2
02F6  11 2000           	LD	DE, 20h
02F9  D5                	PUSH	DE
02FA  FDE9              	JP	(IY)


                        ; TODO ?EXECUTE - Execute Secondary.
02FC  FE02              QEXECUTE	DW $ + 2
02FE  00                	NOP
02FF  FDE9              	JP (IY)

                        ; TODO ?NUMBER - Is the token a Number?
                        ; No - return false
                        ; Yes - push number to stack
0301  6601              QNUMBER	DW	COLON
0303  2E03              	DW	NUMBER
0305  6603              	DW	AT_IF
0307  25                	DB	25H
0308  0E02              	DW	MODE
030A  2802              	DW	C@
030C  6603              	DW	AT_IF
030E  19                	DB	19H
030F  4103              	DW	SINGLE
0311  6603              	DW	AT_IF
0313  0C                	DB	0CH
0314  4603              	DW	STARHASH	; *# *# ; wot is this
0316  4603              	DW	STARHASH
0318  5C03              	DW	COMMA	; ,
031A  5C03              	DW	COMMA	; ,
031C  7103              	DW	AT_ELSE
031E  09                	DB	09H
031F  4603              	DW	STARHASH	; *#
0321  5103              	DW	STCHSH 	; *C#
0323  5C03              	DW	COMMA	; ,
0325  6103              	DW	CCOMMA	; C,
0327  00                	DB	0
0328  7103              	DW	AT_ELSE
032A  03                	DB	03H
032B  01                	DB	1
032C  4E01              	DW	SEMI

                        ; NUMBER
032E  3003              NUMBER	DW	$ + 2
0330  D9                	EXX
0331  2A 8B04           	LD	HL,(DP) ; GET DP
0334  46                	LD	B,(HL)  ; GET LEN
0335  23                	INC	HL	;
0336  7E                	LD	A,(HL)	; GET FIRST CHAR
0337  FE 2D             	CP	2DH 	; MINUS?
0339  3E 00             	LD	A,0
033B  20 03             	JR	NZ,SKIPSAV
033D  3D                	DEC	A
033E  05                	DEC	B
033F  23                	INC	HL
0340  08                SKIPSAV EX	AF, AF'

                        ; TODO - SINGLE
0341  4303              SINGLE	DW $ + 2
0343  00                	NOP
0344  FDE9              	JP	(IY)

                        ; *# - Literal Handler (Headerless)
                        ; Pushes to the stack the word whose address is in the instruction register and
                        ;increments the instruction register twice (past the word literal)
0346  4803              STARHASH DW $ + 2
0348  0A                	LD	A,(BC)
0349  5F                	LD	E,A
034A  03                	INC	BC
034B  0A                	LD	A,(BC)
034C  57                	LD	D,A
034D  03                	INC BC
034E  D5                	PUSH DE
034F  FDE9              	JP (IY)

                        ; TODO - *C#
                        ; Push to the stack the byte whose address is in the instruction register
                        ; and increment instruction register once.
0351  5303              STCHSH	DW $ + 2
0353  0A                	LD	A,(BC)
0354  5F                	LD	E, A
0355  03                	INC	BC
0356  17                	RLA
0357  9F                	SBC	A,A
0358  57                	LD	D,A
0359  D5                	PUSH DE
035A  FDE9              	JP	(IY)

                        ; TODO ,
035C  5E03              COMMA 	DW $ + 2
035E  00                	NOP
035F  FDE9              	JP 	(IY)

                        ; TODO C,
0361  6303              CCOMMA 	DW $ + 2
0363  00                	NOP
0364  FDE9              	JP	(IY)


                        ; @IF
                        ; Top of stack != 0 (true), BC++
                        ; Top of stack == 0 (false), BC <- BC + offset Byte
0366  6803              AT_IF	DW $ + 2
0368  E1                	POP HL
0369  7D                        LD A,L
036A  B4                        OR H
036B  CA 7303                   JP Z,_ELSE
036E  03                        INC BC
036F  FDE9              	JP (IY)

0371  7303              AT_ELSE	DW $ + 2
0373  0A                _ELSE   LD      A,(BC)  ; get jump byte
0374  81                        ADD     A, C       ; add to IR
0375  4F                        LD      C, A    ; Reset IR
0376  30 01                     JR      NC, OUTPG ; Past Page?
0378  04                        INC     B       ;  Yes
0379  FDE9              OUTPG     JP      (IY)


                        ; TODO *WHILE
037B  7D03              AT_WHILE  DW $ + 2

037D  FDE9              	JP (IY)

                        ; TODO *END
037F  8103              AT_END  DW $ + 2

0381  FDE9              	JP (IY)


0383  8503              DUP     DW      $ + 2
0385  E1                        POP     HL
0386  E5                        PUSH    HL
0387  E5                        PUSH    HL
0388  FDE9                      JP      (IY)

                        ; For Z80 MC - DDT was changed to use RST 6 since the hardware uses RST 7.
                        ; For Standard CP/M
038A  8C03              TILHALT	DW	$ + 2

038C  FF                	RST	38H
                        ;	RST 	6
                        ;	ENDIF


                        ; INVALID NUMBER?
                        ; NO -> ASPACE
                        ; YES -> QUESTION

                        ; QUESTION
038D  8F03              QUESTION	DW	$ + 2
038F  2A 8B04           	LD 	HL,(DP)
0392  23                	INC 	HL
0393  CB7E              	BIT	7,(HL)	; IF BIT SET, A TERMINATOR
0395  28 06             	JR	Z,ERROR	;NOT SET ERROR
0397  11 AF03           	LD	DE,OK
039A  D5                	PUSH	DE
039B  FDE9              	JP	(IY)
039D  CD D303           ERROR	CALL	_CRLF
03A0  FD21 A703         	LD	IY,RETURN
03A4  C3 8802           	JP	TYPE
03A7  11 AD03           RETURN	LD	DE, QMSG
03AA  C3 B203           	JP	_PATCH

                        ; GOTO TYPE


                        ; Internals

03AD  3F00              QMSG	DB	'?', 0
03AF  4F4B00            OK	DB	'OK',0

                        ; PATCH internal routine.
03B2  00                _PATCH	DB	0




                        ;----------------------------------------
                        ; CP/M Machine Specific routines
                        ;
                        ; *   Internal Routines interfacing with Operating System.
                        ; * _ECHO - Echo a character to terminal
                        ; * _KEY - Read a key from terminal
                        ; * _CRLF - Output CR/LF to terminal
                        ;----------------------------------------
                        ;; Handy Constants
      = 000D            CR	EQU     0DH
      = 000A            LF	EQU     0AH
      = 0024            DOLLAR  EQU     24H
      = 001B            ESC     EQU     1BH
      = 0003            CTRLC   EQU     03H

                        ; Screen print calls
      = 0003            CHAR_IN EQU     03H
      = 000B            C_STAT  EQU     0BH
      = 0006            C_RAWIO EQU     06H

                        ; til has own write str using _ECHO
                        ;WRITESTR        EQU     9H
      = 0002            PRTCHR  EQU     02H
      = 0005            BDOS    EQU     05H

                        ; Output one character.
                        ; A = Input Char.
                        ; preserve BC register.
                        ; preserve HL register.
03B3                    _ECHO
                         IF CPM = 1
03B3  E5                	PUSH HL
03B4  C5                    PUSH BC
03B5  D5                	PUSH DE
03B6  57                	LD D,A
03B7  5F                	LD E,A
03B8  0E 02                 LD C, PRTCHR
03BA  CD 0500               CALL BDOS
03BD  D1                    POP DE
03BE  C1                	POP BC
03BF  E1                	POP HL
                          ELSE
                          ENDIF
03C0  C9                    RET

                        ; Get a key
03C1                    _KEY
                         IF CPM = 1
                        	; Preserve BC, DE, and HL.
03C1  C5                	PUSH	BC
03C2  D5                	PUSH	DE
03C3  E5                	PUSH	HL
03C4  0E 06             WAITKEY	LD	C, C_RAWIO
03C6  11 FFFF           		LD	DE,FFFFh
03C9  CD 0500           		CALL    BDOS
03CC  B7                		OR 	A
03CD  28 F5             		JR 	Z,WAITKEY
03CF  E1                		POP	HL
03D0  D1                		POP	DE
03D1  C1                		POP	BC
                         ELSE
                         ENDIF
03D2  C9                        RET

                        ; Output CR LF to console.
03D3                    _CRLF
03D3  F5                	PUSH AF
03D4  3E 0D             	LD A, CR
03D6  CD B303           	CALL _ECHO
03D9  3E 0A             	LD A, LF
03DB  CD B303           	CALL _ECHO
03DE  F1                	POP AF
03DF  C9                        RET

                        ; Constants
                        ;
      = 0018            LINEDEL	EQU	18H	; ctrl-x line delete
      = 0020            SPACE	EQU	20h	; space
      = 0008            BKSP	EQU	08h	; ctrl-H backspace

                        ; Variables
03E0  00                BASE	DB	0	; BASE for restart/warm start
03E1  00                MODEVAR	DB	0	; MODE
03E2  0000              LBP	DW	0 	; line buffer pointer
      = 0080            LENGTH	EQU	128	; buffer length
0400                    	ORG	400h	; put on page boundary
0400   (0080)           LBADD	DS	128	; text input buffer
0480  0000              LBEND	DW	0

                        ; CORE points to Core Vocab (first entry in dictionary)
0482  7401              CORE    DW      DICT_BEG

                        ; SYS - hmm
0484  8204              SYS	DW	CORE

                        ;---- used by CONTEXT... points to Vocabulary?
0486  8204              CTXTPTR DW      CORE
0488  8A04              MODEPTR	DW	MODEVAL

048A  00                MODEVAL	DB	0

                        ; Dictonary pointer
048B  B004              DP	DW	DICT
      = 8000            STACK	EQU	8000h

                        ; Strings
048D  0C205449 4C205245 RSTMSG	DB	12, ' TIL RESTART'
