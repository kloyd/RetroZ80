                        ; *****  TIL
                        ; Outer Interpreter
                        ; Author Kelly Loyd
                        ; Target System
                        ;   Z80 CP/M 64K RAM
                        ; ***

                        ; Non Standard Z80 MC
      = 0001            STD_CPM	EQU 1
      = 0000            CPM	EQU	0

                        ; NOTES:
                        ;  Since the Z80 IDE assembler can't do conditionals...
                        ; uncomment CPM stuff
                        ; comment IDE stuff
                        ; or vice versa depending on the selected environment.
                        ;---------- Z80 IDE by Oshonsoft
0000                    	ORG	0H

                        ; For CP/M - should be at 100H (Transient Memory space) to load correctly.
                        ;	ORG	100h

                        ;---------- START/RESTART
0000  11 8D04           START	LD	DE,RSTMSG
0003  3A 5102           	LD	A,(BASE)
0006  A7                	AND	A
0007  20 08             	JR	NZ, ABORT
0009  3E 0A             	LD	A,10
000B  32 5102           	LD	(BASE),A
000E  11 9A04           	LD	DE,SRTMSG
0011  31 0080           ABORT	LD	SP,STACK
0014  D5                	PUSH	DE
0015  21 0000           	LD	HL,0
0018  22 8804           	LD	(MODEPTR),HL
001B  FD21 4900         	LD	IY,NEXT
001F  DD21 2E02         	LD	IX,RETURN
0023  21 8080           	LD	HL,8080h
0026  22 8004           	LD	(LBEND),HL
0029  01 2F00           	LD	BC,OUTER	; Effectively, Set OUTER as the next routine
002C  C3 4900           	JP	NEXT		; Call NEXT in the Inner Interpreter, which will load address of OUTER and Jump to it.

                        ; Entry point of OUTER interpreter.
002F  7701              OUTER	DW	TYPE
0031  8B01              	DW	INLINE
0033  E301              	DW	ASPACE
0035  6900              	DW	TOKEN
0037  4701              	DW 	QSEARCH	; Leaves something on the stack if found or not found?
0039  1102              	DW	TILHALT
003B  F501              	DW	AT_IF



                        ; --------- Inner Interpreter
003D  3F00              SEMI	DW	$ + 2
003F  DD4E 00           	LD	C,(IX+0)
0042  DD23              	INC	IX
0044  DD46 00           	LD	B,(IX+0)
0047  DD23              	INC	IX
0049  0A                NEXT	LD	A,(BC)	; BC = Instruction Register
004A  6F                	LD	L,A	; @I -> WA (HL = word address)
004B  03                	INC	BC
004C  0A                	LD	A,(BC)
004D  67                	LD	H,A
004E  03                	INC	BC	; I = I + 2
004F  5E                RUN	LD	E,(HL)	; @WA -> CA (Code Address)
0050  23                	INC	HL	; WA = WA + 2
0051  56                	LD	D,(HL)
0052  23                	INC	HL
0053  EB                	EX	DE,HL	; CA -> PC
0054  E9                	JP	(HL)

0055  DD2B              COLON	DEC	IX
0057  DD70 00           	LD	(IX+0),B
005A  DD2B              	DEC	IX
005C  DD71 00           	LD	(IX+0),C
005F  4B                	LD	C,E
0060  42                	LD	B,D
0061  FDE9              	JP	(IY)
                        ;----------- End of Inner -----

                        ;----------   IMPORTANT - Start of Vocabulary, Dictionary Entries
                        ;   Any code that is INTERNAL only, should come after the last Dictionary Entry.
0063                    DICT_BEG
0063  05544F4B                  DB 5,'TOK'	; TOKEN ID
0067  9A00              	DW	SEARCH - 6      ; should point to the Entry start.
0069  6B00              TOKEN	DW	$ + 2
006B  D9                	EXX 	; Save IR (EXX exchanges BC, DE, and HL with shadow registers with BC', DE', and HL'.)
006C  2A 5302           	LD	HL,(LBP) ; pointer to token
006F  ED5B 8B04         	LD	DE,(DP) ; pointer to Dictionary
0073  C1                	POP 	BC	; space left by ASPACE
0074  3E 20             	LD	A,20H 	; space code
0076  B9                	CP	C 	; space?
0077  20 06             	JR 	NZ, TOK
0079  BE                IGNLB	CP	(HL)
007A  20 03             	JR	NZ,TOK
007C  2C                	INC	L
007D  18 FA             	JR 	IGNLB
007F  E5                TOK	PUSH	HL
0080  04                COUNT	INC	B
0081  2C                	INC 	L
0082  7E                	LD 	A,(HL)
0083  B9                	CP 	C
0084  28 04             	JR 	Z,ENDTOK
0086  17                	RLA
0087  30 F7             	JR 	NC,COUNT
0089  2D                	DEC	L
008A  2C                ENDTOK	INC	L
008B  22 5302           	LD 	(LBP), HL
008E  78                	LD	A,B
008F  12                	LD	(DE), A
0090  13                	INC	DE
0091  E1                	POP	HL
0092  48                	LD 	C,B
0093  06 00             	LD 	B,0
0095  EDB0              	LDIR  		; Move token to dictionary
0097  D9                	EXX
0098  FDE9              	JP 	(IY)


                        ; SEARCH Primitive
009A  06534541                  DB      6,'SEA'
009E  DA00                      DW      AT - 6     ; Point to the Entry proper.
00A0  A200              SEARCH  DW      $ + 2
00A2  D9                        EXX     ; save registers
00A3  E1                        POP     HL      ; start of header
00A4  E5                TESTIT  PUSH    HL      ; save start of header
00A5  ED5B 8B04                 LD      DE,(DP)         ;dictionary pointer.
00A9  0E 00                     LD      C, 0    ; used with B as false flag
00AB  1A                        LD      A,(DE)  ;get dictionary token length
00AC  BE                        CP      (HL)    ; same as keyword length?
00AD  C2 C700                   JP      NZ, NXTHDR      ; go to next entry in linked list.
00B0  FE 04                     CP      4       ; Is length over 3?
00B2  38 02                     JR      C, BEL04        ; skip set 3
00B4  3E 03                     LD      A, 3    ; length = 3
00B6  47                BEL04   LD      B, A
00B7  23                NEXTCH  INC     HL      ; Bump header
00B8  13                        INC     DE      ; bump dictionary pointer.
00B9  1A                        LD      A, (DE) ; next character
00BA  BE                        CP      (HL)
00BB  20 0A                     JR      NZ, NXTHDR      ; Go to next header entry.
00BD  10 F8                     DJNZ    NEXTCH          ; next character
00BF  E1                        POP     HL      ; start of found header
00C0  11 0600                   LD      DE,6    ; start plus 6
00C3  19                        ADD     HL,DE   ; == Word Address
00C4  E5                        PUSH    HL      ; push WA; BC = 0 for Flag.
00C5  18 0F                     JR      FLAG
00C7  E1                NXTHDR  POP     HL      ; start of current header
00C8  11 0400                   LD      DE,4    ; plus 4 == Link Address (pointer to next entry)
00CB  19                        ADD     HL, DE  ; To Next keyword
00CC  5E                        LD      E, (HL) ; get link address
00CD  23                        INC     HL
00CE  56                        LD      D, (HL)
00CF  EB                        EX      DE, HL
00D0  7C                        LD      A, H
00D1  B5                        OR      L
00D2  20 D0                     JR      NZ, TESTIT ; not 0, test next header.
00D4  0E 01                     LD      C, 1    ; false
00D6  C5                FLAG    PUSH    BC      ; push flag
00D7  D9                        EXX             ;Restore registers
00D8  FDE9                      JP      (IY)    ; back to NEXT

                        ; @ - AT (Assembler won't allow @ for a label.)
00DA  01400000                  DB      1,'@',0,0   ; Search will find length of 1 and only look at first char. others are spaces to fill 3 bytes.
00DE  E900                      DW      CONTEXT - 6
00E0  E200              AT      DW      $ + 2
00E2  E1                        POP     HL
00E3  5E                        LD      E, (HL) ; low byte at address
00E4  23                        INC     HL
00E5  56                        LD      D, (HL) ; high byte
00E6  D5                        PUSH    DE
00E7  FDE9                      JP      (IY)

                        ; CONTEXT, pushes to the stack the address of Vocabulary
00E9  07434F4E                  DB      7,'CON'
00ED  F700                      DW	MODE - 6
00EF  F100              CONTEXT DW      $ + 2
00F1  11 8604           	LD	DE, CTXTPTR
00F4  D5                	PUSH	DE
00F5  FDE9              	JP	(IY)

                        ; MODE, pushes mode pointer to stack
00F7  044D4F44          	DB	4,'MOD'
00FB  0501              	DW	EXECUTE -6
00FD  FF00              MODE	DW	$ + 2
00FF  11 8804           	LD	DE, MODEPTR
0102  D5                	PUSH	DE
0103  FDE9              	JP	(IY)

                        ; EXECUTE primitive needs a dictionary entry for defining words.
                        ; This is a model for all other Primitive words that will be added to the dictionary
                        ;
0105  07455845          	DB	7,'EXE'	; Header for dictionary search
0109  1101              	DW	C@ - 6		; Link address 0000 == End of Linked List.
010B  0D01              EXECUTE DW	$ + 2		; Address of EXECUTE.
010D  E1                	POP	HL		; primitive code.
010E  C3 4F00           	JP	RUN

0111  02434020          	DB 2,'C@ '
0115  2201              	DW	DROP - 6
0117  1901              C@	DW $ + 2
0119  E1                	POP		HL
011A  5E                	LD		E,(HL)
011B  7B                	LD		A,E
011C  17                	RLA
011D  9F                	SBC		A,A
011E  57                	LD		D,A
011F  D5                	PUSH   	DE
0120  FDE9              	JP (IY)

0122  0444524F          	DB	4,'DRO'
0126  2D01              	DW 	STATE - 6
0128  2A01              DROP	DW	$ + 2
012A  E1                	POP	HL
012B  FDE9              	JP (IY)

012D  05535441          	DB 5,'STA' ; STATE
0131  3501              	DW	CX - 6
0133                    STATE
0133  3501              	DW	$ + 2

                        	;; PUSH TO STACK ADDRESS OF SYSTEM STATE VARIABLE
                        	; TODO

0135  02432120          	DB	2,'C! '
0139  3D01              	DW	COMPILER - 6
013B  3D01              CX 	DW	$ + 2

013D  08434F4D          	DB 8, 'COM'   ; PILER --- See *SYS !!! this is an offset to compiler points to last address of compiler dictionary.
0141  0000              	DW	0000
0143                    COMPILER
0143  4501              	DW	$ + 2
0145  0000              	DW 0000

                        ;----------   End of Dictonary Entries

                        ;
                        ; ?SEARCH - Secondary to search dictionary.
0147  5500              QSEARCH DW      COLON
0149  EF00                      DW      CONTEXT
014B  E000                      DW      AT
014D  E000                      DW      AT
014F  A000                      DW      SEARCH
0151  0A02                      DW      DUP
0153  F501                      DW      AT_IF
0155  20                	DB	20H
0156  FD00                      DW	MODE
0158  1701              	DW	C@
015A  F501              	DW	AT_IF
015C  19                	DB	19H
015D  2801              	DW	DROP
015F  4301              	DW	COMPILER
0161  E000              	DW	AT
0163  A000              	DW	SEARCH
0165  0A02              	DW	DUP
0167  F501              	DW	AT_IF
0169  06                	DB	06H
016A  0000              	DW	0
016C  0002              	DW	AT_ELSE
016E  03                	DB	03
016F  0100              	DW	1
0171  3301              	DW	STATE
0173  3B01              	DW	CX
0175  3D00              	DW	SEMI




                        ; TYPE - String with length byte (0a1234567890) printed to console.
0177  7901              TYPE	DW	$ + 2
0179  D1                TYPEIT	POP	DE	; get address of string
017A  E5                	PUSH	HL 	; save WA
017B  C5                	PUSH	BC	; Save IR.
017C  EB                	EX	DE,HL
017D  46                	LD	B,(HL)
017E  23                	INC	HL
017F  7E                ONECHAR	LD	A,(HL)
0180  CD 3A02           	CALL	_ECHO
0183  23                	INC	HL
0184  10 F9             	DJNZ	ONECHAR
0186  C1                	POP	BC	; Restore IR
0187  E1                	POP	HL	; Restore WA
0188  C3 4900           	JP	NEXT




                        ; INLINE
018B  8D01              INLINE	DW	$ + 2	;header address
018D  C5                	PUSH	BC	; Save IR
018E  CD 4402           ISTART	CALL	_CRLF	; Issue CR / LF on terminal for new input
0191  21 0004           	LD	HL, LBADD	; Buffer
0194  22 5302           	LD	(LBP), HL
0197  06 80             	LD	B, LENGTH
0199  36 20             CLEAR	LD	(HL), SPACE
019B  23                	INC	HL
019C  10 FB             	DJNZ	CLEAR
019E  2E 00             ZERO	LD	L,0
01A0  CD 3D02           INKEY	CALL	_KEY
01A3  FE 18             	CP	LINEDEL		; CTRL-X is Line Delete
01A5  20 05             	JR	NZ,TSTBS
01A7  CD 3A02           	CALL	_ECHO
01AA  18 E2             	JR ISTART
01AC  FE 08             TSTBS	CP	BKSP		; backspace CTRL-H
01AE  20 0B             	JR	NZ, TSTCR
01B0  2B                	DEC	HL
01B1  FA 9E01           	JP	M,ZERO
01B4  36 20             	LD	(HL), SPACE
01B6  CD 3A02           ISSUE	CALL	_ECHO
01B9  18 E5             	JR	INKEY
01BB  FE 0D             TSTCR	CP	CR
01BD  28 1C             	JR	Z,LAST1
01BF  CB7D              	BIT	7,L
01C1  20 0E             	JR	NZ,IEND
01C3  77                SAVEIT	LD	(HL),A
01C4  FE 61             	CP	61H	; Less than LC A ?
01C6  38 06             	JR	C,NOTLC
01C8  FE 7B             	CP	7BH	; MORE THAN LC Z?
01CA  30 02             	JR	NC,NOTLC
01CC  CBAE              	RES	5,(HL)
01CE  2C                NOTLC	INC	L
01CF  18 E5             	JR	ISSUE
01D1  2D                IEND	DEC	L
01D2  4F                	LD	C,A
01D3  3E 08             	LD	A,BKSP
01D5  CD 3A02           	CALL	_ECHO
01D8  79                	LD	A,C
01D9  18 E8             	JR 	SAVEIT
01DB  3E 20             LAST1	LD	A, SPACE
01DD  CD 3A02           	CALL	_ECHO
01E0  C1                	POP	BC
01E1  FDE9              	JP	(IY)	; Return to NEXT inner interpreter.

                        ; Push 20h to stack, will pop into BC in TOKEN, and BC will be 0020h
01E3  E501              ASPACE	DW	$ + 2
01E5  11 2000           	LD	DE, 20h
01E8  D5                	PUSH	DE
01E9  FDE9              	JP	(IY)



                        ; ABSENT?
                        ; - NO -> ?EXECUTE -> ASPACE
                        ; - YES -> NUMBER

                        ; ?EXECUTE - Execute Secondary.
01EB  ED01              QEXECUTE	DW $ + 2
01ED  00                	NOP
01EE  FDE9              	JP (IY)

01F0  F201              QNUMBER		DW $ + 2
01F2  00                	NOP
01F3  FDE9              	JP (IY)

01F5  F701              AT_IF	DW $ + 2
01F7  E1                	POP HL
01F8  7D                        LD A,L
01F9  B4                        OR H
01FA  CA 0202                   JP Z,_ELSE
01FD  03                        INC BC
01FE  FDE9              	JP (IY)

0200  0202              AT_ELSE	DW $ + 2
0202  0A                _ELSE   LD      A,(BC)  ; get jump byte
0203  81                        ADD     A, C       ; add to IR
0204  4F                        LD      C, A    ; Reset IR
0205  30 01                     JR      NC, OUTPG ; Past Page?
0207  04                        INC     B       ;  Yes
0208  FDE9              OUTPG     JP      (IY)



020A  0C02              DUP     DW      $ + 2
020C  E1                        POP     HL
020D  E5                        PUSH    HL
020E  E5                        PUSH    HL
020F  FDE9                      JP      (IY)

                        ; For Z80 MC - DDT was changed to use RST 6 since the hardware uses RST 7.
                        ; For Standard CP/M
0211  1302              TILHALT	DW	$ + 2

0213  FF                	RST	38H
                        ;	RST 	6
                        ;	ENDIF


                        ; INVALID NUMBER?
                        ; NO -> ASPACE
                        ; YES -> QUESTION

                        ; QUESTION
0214  1602              QUESTION	DW	$ + 2
0216  2A 8B04           	LD 	HL,(DP)
0219  23                	INC 	HL
021A  CB7E              	BIT	7,(HL)	; IF BIT SET, A TERMINATOR
021C  28 06             	JR	Z,ERROR	;NOT SET ERROR
021E  11 3602           	LD	DE,OK
0221  D5                	PUSH	DE
0222  FDE9              	JP	(IY)
0224  CD 4402           ERROR	CALL	_CRLF
0227  FD21 2E02         	LD	IY,RETURN
022B  C3 7701           	JP	TYPE
022E  11 3402           RETURN	LD	DE, QMSG
0231  C3 3902           	JP	_PATCH

                        ; GOTO TYPE


                        ; Internals

0234  3F00              QMSG	DB	'?', 0
0236  4F4B00            OK	DB	'OK',0

                        ; PATCH internal routine.
0239  00                _PATCH	DB	0




                        ;----------------------------------------
                        ; CP/M Machine Specific routines
                        ;
                        ; *   Internal Routines interfacing with Operating System.
                        ; * _ECHO - Echo a character to terminal
                        ; * _KEY - Read a key from terminal
                        ; * _CRLF - Output CR/LF to terminal
                        ;----------------------------------------
                        ;; Handy Constants
      = 000D            CR	EQU     0DH
      = 000A            LF	EQU     0AH
      = 0024            DOLLAR  EQU     24H
      = 001B            ESC     EQU     1BH
      = 0003            CTRLC   EQU     03H

                        ; Screen print calls
      = 0003            CHAR_IN EQU     03H
      = 000B            C_STAT  EQU     0BH
      = 0006            C_RAWIO EQU     06H

                        ; til has own write str using _ECHO
                        ;WRITESTR        EQU     9H
      = 0002            PRTCHR  EQU     02H
      = 0005            BDOS    EQU     05H

                        ; CPM or IDE
                        ; Output one character.
                        ; A = Input Char.
                        ; preserve BC register.
                        ; preserve HL register.
023A                    _ECHO
                        ;#IF CPM == 1
                        ;	PUSH HL
                        ;	PUSH BC
                        ;	PUSH DE
                        ;	LD D,A
                        ;	LD E,A
                        ;	LD C, PRTCHR
                        ;	CALL BDOS
                        ;	POP DE
                        ;	POP BC
                        ;	POP HL
                        ;ELSE
023A  D3 01             	OUT (01), A
                        ;ENDIF
023C  C9                        RET

                        ; Get a key
023D                    _KEY
                        ; Preserve BC, DE, and HL.
                        ;	PUSH	BC
                        ;	PUSH	DE
                        ;	PUSH	HL
                        ;WAITKEY LD	C, C_RAWIO
                        ;        LD	DE,FFFFh
                        ;        CALL    BDOS
                        ;        OR 	A
                        ;        JR 	Z,WAITKEY
                        ;	POP	HL
                        ;        POP	DE
                        ;        POP	BC
023D  DB 00             INKEYW	IN A, (00H)
023F  E6 FF             	AND FFH
0241  28 FA             	JR Z, INKEYW
                        ; Character returned in A register.
0243  C9                        RET

                        ; Output CR LF to console.
0244                    _CRLF
0244  F5                	PUSH AF
0245  3E 0D             	LD A, CR
0247  CD 3A02           	CALL _ECHO
024A  3E 0A             	LD A, LF
024C  CD 3A02           	CALL _ECHO
024F  F1                	POP AF
0250  C9                        RET

                        ; Constants
                        ;
      = 0018            LINEDEL	EQU	18H	; ctrl-x line delete
      = 0020            SPACE	EQU	20h	; space
      = 0008            BKSP	EQU	08h	; ctrl-H backspace

                        ; Variables
0251  00                BASE	DB	0	; BASE for restart/warm start
0252  00                MODEVAR	DB	0	; MODE
0253  0000              LBP	DW	0 	; line buffer pointer
      = 0080            LENGTH	EQU	128	; buffer length
0400                    	ORG	400h	; put on page boundary
0400   (0080)           LBADD	DS	128	; text input buffer
0480  0000              LBEND	DW	0

                        ; CORE points to Core Vocab (first entry in dictionary)
0482  6300              CORE    DW      DICT_BEG

                        ; SYS - hmm
0484  8204              SYS	DW	CORE

                        ;---- used by CONTEXT... points to Vocabulary?
0486  8204              CTXTPTR DW      CORE
0488  8A04              MODEPTR	DW	MODEVAL

048A  00                MODEVAL	DB	0

                        ; Dictonary pointer
048B  B004              DP	DW	DICT
      = 8000            STACK	EQU	8000h

                        ; Strings
048D  0C205449 4C205245 RSTMSG	DB	12, ' TIL RESTART'
0495  53544152 54
049A  15205745 4C434F4D SRTMSG	DB	21, ' WELCOME TO RETRO TIL'
04A2  4520544F 20524554
04AA  524F2054 494C


04B0   (0FA0)           DICT    DS      4000




1450                    	END


