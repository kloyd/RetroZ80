0437   033A             PRTCHR  EQU     02H
0438   033A             BDOS    EQU     05H
0439   033A             
0440   033A             ; Output one character.
0441   033A             ; A = Input Char.
0442   033A             ; preserve BC register.
0443   033A             ; preserve HL register.
0444   033A             _ECHO
0445   033A             ;#IF CPM == 1
0446   033A             ;	PUSH HL
0447   033A              ;       PUSH BC
